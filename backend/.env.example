# Backend environment configuration
APP_ENV=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# Database configuration
DATABASE_URL=postgresql://mlbb:mlbb@db:5432/mlbb

# Cache / rate limiting configuration
CACHE_URL=redis://cache:6379/0
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REQUESTS=120

# Third-party integrations / data sources
MLBB_API_BASE_URL=https://api.mobilelegends.com
MLBB_API_KEY=replace-me

# Security
ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=replace-this-secret
JWT_ACCESS_TOKEN_EXPIRES=900

# Observability
SENTRY_DSN=
ENABLE_REQUEST_LOGGING=true

